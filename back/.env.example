# 이 파일을 복사해 back/.env 를 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# ── Supabase (대시보드 → Project Settings → API) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key (또는 Secret key, sb_secret_...) — RLS를 우회하는 관리자 키. 절대 프론트/깃에 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 직접 Postgres 접속 (pgvector, 대량 적재용) — 대시보드 상단 Connect → Session pooler 문자열
# DATABASE_URL=postgresql://postgres.xxxx:[비밀번호]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── 공공데이터 수집 (work.md 4.1) ──
# 공공데이터포털(data.go.kr) 일반 인증키 (Decoding) — K-Startup 조회서비스
DATA_GO_KR_SERVICE_KEY=
# 온통청년(youthcenter.go.kr) 청년정책 API 키
YOUTH_CENTER_API_KEY=
# 기업마당(bizinfo.go.kr) 지원사업정보 API 키
BIZINFO_API_KEY=

# ── LLM / 임베딩 (자격요건 추출, 요약 카드, RAG) ──
# 사용할 LLM 제공처 키 (예: Anthropic)
ANTHROPIC_API_KEY=
# 임베딩 모델 제공처 키 (사용하는 서비스에 맞게 이름 변경)
EMBEDDING_API_KEY=
