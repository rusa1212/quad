# 이 파일을 복사해 front/.env 를 만들고 값을 채우세요. (.env 는 git에 올라가지 않습니다)
# Supabase 대시보드 → Project Settings → API

# Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon public key (또는 Publishable key, sb_publishable_...) — 브라우저에 노출돼도 되는 키
VITE_SUPABASE_ANON_KEY=

# FastAPI 백엔드 주소
VITE_API_BASE_URL=http://localhost:8000
# AI 질문 화면: 백엔드(/api/ask)가 준비되기 전에는 예시 답변(mock)으로 동작. 실제 서버를 쓰려면 false
VITE_ASK_MOCK=true
